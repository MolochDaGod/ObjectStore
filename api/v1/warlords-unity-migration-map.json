  "principles": [
    "Entity icons name the Warlords prefab id (entities/<slug>).",
    "Match Unity prefab by alias or name before inventing meshes.",
    "Player race bodies → prefer grudge6 CDN FBX over legacy Unity player prefabs.",
    "Buildings: Structure Crusade/Legion/Fabled + Structures are primary Unity building sources.",
    "Harvest/nature: prefer stylized CDN packs; Unity Harvestables are legacy fallback.",
    "Preview/Invis prefabs are not ship targets.",
    "Pipeline: Unity prefab → resolve FBX/anim → FBX→GLB bake → R2 + D1 → ObjectStore catalog."
  ],
  "pipeline": [
    {
      "step": 1,
      "name": "inventory",
      "script": "scripts/inventory-unity-warlords-migration.mjs"
    },
    {
      "step": 2,
      "name": "match_icons",
      "output": "api/v1/warlords-unity-migration-map.json"
    },
    {
      "step": 3,
      "name": "extract_sources",
      "output": "assets/unity-extract/"
    },
    {
      "step": 4,
      "name": "convert_glb",
      "skill": "grudge-asset-convert / gltf-asset-pipeline"
    },
    {
      "step": 5,
      "name": "upload_r2_seed_d1",
      "skill": "grudge-d1-r2"
    },
    {
      "step": 6,
      "name": "wire_warlords_loaders",
      "skill": "grudge-warlords-assets"
    }
  ],
