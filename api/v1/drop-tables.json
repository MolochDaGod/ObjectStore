  "formulas": {
    "effectiveLevel": "clamp(playerLevel + difficulty.levelBias, 1, 70)",
    "maxTierFromLevel": "from playerLevelToMaxTier table using effectiveLevel",
    "maxTierFinal": "min(5, maxTierFromLevel)  // hard ban 6–8",
    "targetTier": "min(maxTierFinal, floor((effectiveLevel - 1) / 10))",
    "tierWeight": "softTarget[maxTier][t] * (decay ^ abs(t - targetTier)) * (t===0 ? difficulty.t0WeightMul * category.t0FloorWeight factor : difficulty.rareMul for t>=3)",
    "rollCount": "randomInt(source.rolls.min, source.rolls.max) * difficulty.qtyMul (rounded)",
    "never": "if tier >= 6 return reject; if tier not in category.allowTiers reject"
  },
