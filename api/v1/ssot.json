    "edit": "ObjectStore api/v1/*.json on main",
    "sync": "npm run sync:docs",
    "ship": "git push origin main → Vercel objectstore-grudge → info.grudge-studio.com",
    "proxy": "GET objectstore.grudge-studio.com/api/v1/:name.json fetches info.*",
    "doNot": [
      "Do not wrangler catalog JSON onto R2",
      "Do not start from molochdagod.github.io/ObjectStore",
      "Do not start from forge-editor.json",
      "Do not mix feat/blox-edge-proxy WIP into an info JSON deploy"
    ]
  },
