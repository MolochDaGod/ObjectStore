{
  "version": {
    "worldFleet": "2026-09-06",
    "assetCatalog": "2026-09-06",
    "definitions": "2026-09-06"
  },
  "law": "Catalog SSOT = objectstore.grudge-studio.com/api/v1/*.json (Worker). Binaries = assets.grudge-studio.com. Player bag/craft XP = Railway. Start catalog updates from game-data-manifest + master items/recipes/materials/harvest — not forge-editor.json and not github.io. Legacy: info.grudge-studio.com (Vercel objectstore-grudge) NOT catalog SSOT.",
  "startHere": "/api/v1/game-data-manifest.json",
  "runtimeIndex": "/api/v1/games-library.json",
  "catalogSSOT": "https://objectstore.grudge-studio.com",
  "cdn": "https://assets.grudge-studio.com",
  "open": "https://open.grudge-studio.com",
  "legacy": {
    "info": "https://info.grudge-studio.com",
    "note": "NOT catalog SSOT"
  },
  "deploy": {
    "edit": "ObjectStore api/v1/*.json on main",
    "sync": "npm run sync:docs",
    "ship": "git push origin main → Worker objectstore.grudge-studio.com serves catalog",
    "ssot": "GET objectstore.grudge-studio.com/api/v1/:name.json (Worker routes)",
    "doNot": [
      "Do not wrangler catalog JSON onto R2 manually",
      "Do not start from molochdagod.github.io/ObjectStore",
      "Do not start from forge-editor.json",
      "Do not document bare GET /api/v1 (404; use /api/v1/catalog.json or named files)",
      "Do not present info.grudge-studio.com or Vercel objectstore-grudge as catalog SSOT"
    ]
  },
  "graph": {
    "harvestToMaterial": "master-harvest-nodes.json → drops[].materialUuid (loot follows profession level, not node quality)",
    "materialToRecipe": "master-recipes.json → materials[].uuid",
    "recipeToItem": "master-recipes.json → resultItemId → master-items.json",
    "itemToIcon": "master-items.json → iconUrl (assets.grudge-studio.com)",
    "craftScope": "mats → account bag; profession XP → character UUID"
  },
  "catalogs": {
    "gameDataManifest": "/api/v1/game-data-manifest.json",
    "gamesLibrary": "/api/v1/games-library.json",
    "canonicalItems": "/api/v1/canonical-items-manifest.json",
    "masterItems": "/api/v1/master-items.json",
    "masterRecipes": "/api/v1/master-recipes.json",
    "masterMaterials": "/api/v1/master-materials.json",
    "masterHarvestNodes": "/api/v1/master-harvest-nodes.json",
    "masterProfessions": "/api/v1/master-professions.json",
    "uuidLaw": "/api/v1/uuid-law.json",
    "accountGameUuidContract": "/api/v1/account-game-uuid-contract.json",
    "islandBuildingPrefabs": "/api/v1/island-building-prefabs.json",
    "gameReadySceneIndex": "/api/v1/game-ready-scene-index.json",
    "homeIslandContract": "/api/v1/home-island-contract.json",
    "masterWeaponPrefabs": "/api/v1/master-weapon-prefabs.json",
    "masterWeaponSkills": "/api/v1/master-weaponSkills.json",
    "masterSkillTrees": "/api/v1/master-skillTrees.json",
    "classSkillBridges": "/api/v1/class-skill-bridges.json",
    "classes": "/api/v1/classes.json",
    "races": "/api/v1/races.json",
    "superTerrain": "/api/v1/super-terrain.json",
    "forgeEditor": "/api/v1/forge-editor.json"
  }
