export const REFINE_STATS = {
  total: REFINE_RECIPES.length,
  byProcess: {
    smelt: getRefineRecipesByProcess('smelt').length,
    mill: getRefineRecipesByProcess('mill').length,
    weave: getRefineRecipesByProcess('weave').length,
    tan: getRefineRecipesByProcess('tan').length,
    grind: getRefineRecipesByProcess('grind').length,
    spin: getRefineRecipesByProcess('spin').length,
  },
};
