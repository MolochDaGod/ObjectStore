  "lines": [
    {
      "uuid": "LORE-A901-0CA2-9AE4",
      "slug": "lorian-hunt",
      "title": "The Unwoven Thread",
      "god": {
        "uuid": "LORE-C262-3EBC-5A48",
        "slug": "lorian",
        "name": "Lorian, the Weaver of Fate",
        "race": "human",
        "domain": [
          "Fate",
          "choice",
          "ambition"
        ]
      },
      "faction": "crusade",
      "startTown": {
        "name": "Whitehaven",
        "spawnPlace": "crusade-capital",
        "chartIsle": "stable:ashen_throne"
      },
      "giver": {
        "name": "Herald Maud",
        "profileId": "crusade_herald"
      },
      "ally": {
        "name": "Lord-Marshal Edric Halloway",
        "profileId": "crusade_marshal"
      },
      "loreSite": {
        "name": "Raider Ridge",
        "spawnPlace": "main",
        "spreadZone": "rol-ogre-raid"
      },
      "encounter": {
        "chartIsle": "event:crusade:2",
        "name": "Ashen Ring",
        "sector": "ashen_wastes"
      },
      "quests": [
        {
          "id": "gh-lorian-1",
          "title": "Threads in the Glass",
          "text": "Since the Godwake the glass storms over Ashen Ring show Crusaders futures they never chose. Herald Maud says a thread of Lorian's loom has come loose. Take the Lord-Marshal's leave, find where oaths are being broken, and bring timber for a new loom frame.",
          "steps": [
            {
              "kind": "talk",
              "target": "gh-lord-marshal",
              "text": "Talk to Lord-Marshal Edric Halloway"
            },
            {
              "kind": "reach",
              "target": "raider-ridge",
              "text": "Reach Raider Ridge"
            },
            {
              "kind": "kill",
              "target": "oathbreaker",
              "count": 3,
              "foe": [
                "ogre-paladin"
              ],
              "text": "Defeat 3 × oathbreaker"
            },
            {
              "kind": "collect",
              "target": "woodcutting",
              "count": 12,
              "text": "Gather 12 through Woodcutting"
            }
          ],
          "rewards": {
            "gold": 150,
            "xp": 600,
            "materials": []
          }
        },
        {
          "id": "gh-lorian-2",
          "title": "The Loomwarden",
          "text": "When Ashen Ring rises, the Loomwarden walks its glass and weaves each challenger a choice. Choose well, and break the knot it ties around you.",
          "steps": [
            {
              "kind": "reach",
              "target": "ashen-ring",
              "text": "Reach Ashen Ring"
            },
            {
              "kind": "kill",
              "target": "loomwarden",
              "text": "Defeat The Loomwarden"
            }
          ],
          "rewards": {
            "gold": 400,
            "xp": 1500,
            "materials": [
              {
                "uuid": "MATL-20260621232130-000A36-AF4554CA",
                "id": "starweave-thread",
                "qty": 3
              },
              {
                "uuid": "MATL-20260621232130-000A37-8FDF1813",
                "id": "voidweave-thread",
                "qty": 1
              }
            ]
          }
        }
      ],
      "lore": [
        {
          "title": "Snapped Oath-Cord",
          "text": "An ogre knot cut clean through. Humans say every broken oath is a thread Lorian has to weave again."
        },
        {
          "title": "The Glass Loom",
          "text": "Storm-glass fused into warp and weft. In it you see two roads and the one you took."
        }
      ],
      "boss": {
        "uuid": "LORE-7DF9-74F7-49BC",
        "id": "god_avatar_lorian",
        "name": "The Loomwarden",
        "title": "Thread of Lorian",
        "level": 20,
        "hp": 4800,
        "phases": 2,
        "art": {
          "status": "missing",
          "marker": "missing",
          "want": "tall robed figure with a loom of light (lore-canon LORE-C262-3EBC-5A48)"
        },
        "mechanics": {
          "phase1": {
            "name": "Trial",
            "hp_threshold": "100%-50%",
            "abilities": [
              {
                "id": "severed-thread",
                "name": "Severed Thread",
                "damage": 28,
                "desc": "Line rush up to 24 m, 2.6 m wide; side-step the telegraph."
              },
              {
                "id": "loom-of-choices",
                "name": "Loom of Choices",
                "damage": 26,
                "desc": "Marks a 3.2 m circle under every fighter plus 2 more; move out before it lands."
              },
              {
                "id": "fates-knot",
                "name": "Fate's Knot",
                "damage": 24,
                "desc": "Close swing, 3.6 m reach; dodge or guard."
              }
            ]
          },
          "phase2": {
            "name": "THE LOOM UNRAVELS",
            "hp_threshold": "50%-0%",
            "speedMul": 1.3,
            "abilities": [
              {
                "id": "unweaving",
                "name": "Unweaving",
                "damage": 38,
                "desc": "9 m burst around the avatar with a shockwave; get out of the ring."
              }
            ]
          }
        }
      }
    },
