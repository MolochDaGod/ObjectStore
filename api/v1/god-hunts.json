        },
        {
          "id": "gh-thalindra-2",
          "title": "The Thornmother's Trial",
          "text": "Starfall Shoal rises with the tide, and the Thornmother rises with it, crowned in leaf and vine. She does not hate you. She tests whether you take only what the wild can give back.",
          "steps": [
            {
              "kind": "reach",
              "target": "starfall-shoal",
              "text": "Reach Starfall Shoal"
            },
            {
              "kind": "kill",
              "target": "thornmother",
