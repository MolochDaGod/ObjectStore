                "id": "worldtree-log",
                "qty": 2
              },
              {
                "uuid": "MATL-20260621232130-000A49-A62BD5F7",
                "id": "ancient-essence",
                "qty": 1
              }
            ]
          }
        }
      ],
      "lore": [
        {
          "title": "Warden Rings",
          "text": "Bark grown in circles around a footprint of leaves. The wardens stand where she stood."
        },
        {
          "title": "Tide-Grown Altar",
          "text": "Vines knotted into a seat above the waterline. Every creature on the shoal faces it."
        }
